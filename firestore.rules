rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Covers every subcollection under a user's document (plans,
      // coachMessages, and anything added later) with the same ownership
      // check, so new features never need a new rule added by hand.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
